# Jira Server/DC (PLF lives at jira.regnology.net)
JIRA_BASE_URL=https://jira.regnology.net
JIRA_EMAIL=you@regnology.net
JIRA_API_TOKEN=
# JIRA_API_MODE=server   # server | cloud | auto (default)

# Optional JQL override (default is PLF TrinoMigration stories created today)
# JIRA_JQL=project = PLF AND issuetype = Story AND created >= startOfDay() AND (labels = TrinoMigration OR component = "Team Trino Migration")

# Confluence Server/DC page for daily results
CONFLUENCE_BASE_URL=https://confluence.regnology.net
CONFLUENCE_PAGE_URL=https://confluence.regnology.net/x/7BRYEg
# Prefer explicit page id (tiny links need auth redirect to resolve)
CONFLUENCE_PAGE_ID=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
# CONFLUENCE_CLOUD=true   # set if publishing to Atlassian Cloud wiki instead

REPORT_RETENTION_DAYS=3
REPORT_TIMEZONE=UTC
# RESULTS_DIR=results
# SKIP_CONFLUENCE=true
# DRY_RUN=true
